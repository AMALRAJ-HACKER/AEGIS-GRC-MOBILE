# Copy this file to `.env` and fill in your Supabase project values.
# `.env` and `.env.local` are git-ignored — never commit real keys.

# Supabase project URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable / anon key (safe for client bundles, but keep per-project)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: override the Metro host served to Expo Go on your LAN
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.10
